<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lịch Âm Widget · Ken Phúc"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Tùy chỉnh giao diện Kính Lỏng, Lịch Âm &amp; Hiệu ứng thời tiết"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_liquid_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Cỡ đồng hồ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cỡ số đồng hồ" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/tv_clock_size_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="36sp" android:textColor="#FFD54F" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/sb_clock_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:max="36" />

            <!-- Tỷ lệ chữ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tỷ lệ kích thước chữ" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/tv_text_scale_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="95%" android:textColor="#FFD54F" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/sb_text_scale" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:max="60" />

            <!-- Độ đục nền kính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Độ đục nền kính" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/tv_bg_alpha_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="48%" android:textColor="#FFD54F" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/sb_bg_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:max="100" />

            <!-- Bố cục -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vị trí đồng hồ" android:textColor="#CBD5E1" android:textSize="12sp" />
            <Spinner android:id="@+id/sp_layout_mode" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="10dp" android:background="#1E293B" />

            <!-- Phông chữ -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kiểu phông chữ" android:textColor="#CBD5E1" android:textSize="12sp" />
            <Spinner android:id="@+id/sp_font_type" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="8dp" android:background="#1E293B" />

            <Button
                android:id="@+id/btn_pick_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Chọn file phông chữ (.ttf)" />

            <!-- Màu nền kính -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tông màu nền kính" android:textColor="#CBD5E1" android:textSize="12sp" />
            <Spinner android:id="@+id/sp_bg_color" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="10dp" android:background="#1E293B" />

            <!-- Màu nhấn -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Màu nhấn Âm lịch &amp; Hôm nay" android:textColor="#CBD5E1" android:textSize="12sp" />
            <Spinner android:id="@+id/sp_accent_color" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="12dp" android:background="#1E293B" />

            <!-- Bật tắt hiệu ứng -->
            <Switch
                android:id="@+id/sw_enable_effects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:checked="true"
                android:text="Bật hiệu ứng chuyển động thời tiết &amp; lễ hội"
                android:textColor="#FFFFFF" />

            <!-- Chế độ chạy thử hiệu ứng -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chế độ hiệu ứng" android:textColor="#CBD5E1" android:textSize="12sp" />
            <Spinner android:id="@+id/sp_test_effect" android:layout_width="match_parent" android:layout_height="42dp" android:background="#1E293B" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_sync_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Đồng bộ thời tiết ngay" />

        <Button
            android:id="@+id/btn_pin_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ghim Widget ra màn hình chính" />

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2563EB"
            android:text="Lưu &amp; Cập nhật Widget"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
