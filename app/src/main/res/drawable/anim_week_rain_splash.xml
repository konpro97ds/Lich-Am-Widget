<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="336dp"
            android:height="12dp"
            android:viewportWidth="336"
            android:viewportHeight="12">

            <!-- Màng nước loang mỏng sát mép trên dải lịch (Y = 11.2) -->
            <path
                android:name="water_film_a"
                android:strokeColor="#66E0F2FE"
                android:strokeWidth="0.7"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:pathData="M38,11.2 L46,11.2 M132,11.2 L141,11.2 M228,11.2 L237,11.2 M296,11.2 L304,11.2" />

            <!-- Hạt nước bật nảy sang trái - Đợt A -->
            <group android:name="bounce_left_a">
                <path
                    android:name="dot_la"
                    android:fillColor="#E0F2FE"
                    android:fillAlpha="0.0"
                    android:pathData="M42,10.5 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 M136,10.5 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 M232,10.5 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 M300,10.5 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0" />
            </group>

            <!-- Hạt nước bật nảy sang phải - Đợt A -->
            <group android:name="bounce_right_a">
                <path
                    android:name="dot_ra"
                    android:fillColor="#FFFFFF"
                    android:fillAlpha="0.0"
                    android:pathData="M43,10.5 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 M137,10.5 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 M233,10.5 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 M301,10.5 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0" />
            </group>

            <!-- Hạt nước bật nảy sang trái - Đợt B lệch nhịp -->
            <group android:name="bounce_left_b">
                <path
                    android:name="dot_lb"
                    android:fillColor="#BAE6FD"
                    android:fillAlpha="0.0"
                    android:pathData="M86,10.5 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 M184,10.5 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 M268,10.5 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0" />
            </group>

            <!-- Hạt nước bật nảy sang phải - Đợt B lệch nhịp -->
            <group android:name="bounce_right_b">
                <path
                    android:name="dot_rb"
                    android:fillColor="#FFFFFF"
                    android:fillAlpha="0.0"
                    android:pathData="M87,10.5 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 M185,10.5 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 M269,10.5 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="water_film_a">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:duration="420" android:valueFrom="0.0" android:valueTo="0.75" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <!-- Quỹ đạo bật nảy parabol (bật lên -5.5 rồi rơi lại 0) -->
    <target android:name="bounce_left_a">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateX" android:duration="840" android:valueFrom="0" android:valueTo="-4.2" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="translateY" android:duration="420" android:valueFrom="0" android:valueTo="-5.2" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot_la">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="420" android:valueFrom="0.95" android:valueTo="0.1" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <target android:name="bounce_right_a">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateX" android:duration="840" android:valueFrom="0" android:valueTo="3.8" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="translateY" android:duration="420" android:valueFrom="0" android:valueTo="-4.5" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot_ra">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="420" android:valueFrom="0.90" android:valueTo="0.1" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <!-- Đợt B lệch nhịp 1060ms -->
    <target android:name="bounce_left_b">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateX" android:duration="1060" android:valueFrom="0" android:valueTo="-4.2" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="translateY" android:duration="530" android:valueFrom="0" android:valueTo="-5.0" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot_lb">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="530" android:valueFrom="0.1" android:valueTo="0.95" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <target android:name="bounce_right_b">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateX" android:duration="1060" android:valueFrom="0" android:valueTo="3.8" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="translateY" android:duration="530" android:valueFrom="0" android:valueTo="-4.4" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot_rb">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="530" android:valueFrom="0.1" android:valueTo="0.90" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>
</animated-vector>
