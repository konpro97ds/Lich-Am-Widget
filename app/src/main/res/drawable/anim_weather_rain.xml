            <group android:name="rain_mid">
                <path
                    android:strokeColor="#6CE0F2FE"
                    android:strokeWidth="0.8"
                    android:strokeLineCap="round"
                    android:pathData="M32,-30 L28,-17 M64,-16 L62,-9 M96,-34 L92,-20 M128,-20 L126,-13 M160,-32 L156,-18 M192,-14 L190,-7 M224,-28 L220,-15 M256,-18 L254,-11 M286,-30 L282,-17 M20,20 L16,33 M52,32 L50,39 M84,16 L80,30 M116,28 L114,35 M148,18 L144,32 M180,30 L178,37 M212,16 L208,30 M244,28 L242,35 M276,20 L272,33 M36,60 L32,73 M68,72 L66,79 M100,56 L96,70 M132,68 L130,75 M164,58 L160,72 M196,70 L194,77 M228,56 L224,70 M260,68 L258,75 M290,60 L286,73" />
            </group>

            <!-- Tầng 3: Mưa cận cảnh mảnh mềm 60fps -->
            <group android:name="rain_near">
                <path
                    android:strokeColor="#99FFFFFF"
                    android:strokeWidth="1.0"
                    android:strokeLineCap="round"
                    android:pathData="M42,-36 L36,-18 M98,-22 L94,-10 M154,-38 L148,-20 M210,-20 L206,-8 M266,-34 L260,-16 M26,18 L20,36 M82,30 L78,42 M138,14 L132,32 M194,26 L190,38 M250,16 L244,34 M48,62 L42,80 M104,74 L100,86 M160,58 L154,76 M216,70 L212,82 M272,60 L266,78" />
            </group>

            <!-- Giọt nước nhỏ từ mép dưới dải Lịch Âm rơi xuống dải dự báo -->
            <group android:name="drip_1">
                <path
                    android:fillColor="#CCE0F2FE"
                    android:pathData="M64,113 C65.1,115.2 65.5,116.4 65.5,117.5 C65.5,118.8 64.8,119.6 64,119.6 C63.2,119.6 62.5,118.8 62.5,117.5 C62.5,116.4 62.9,115.2 64,113 Z" />
            </group>

            <group android:name="drip_2">
                <path
                    android:fillColor="#E6FFFFFF"
                    android:pathData="M148,113 C149.2,115.4 149.6,116.6 149.6,117.8 C149.6,119.2 148.8,120.0 148,120.0 C147.2,120.0 146.4,119.2 146.4,117.8 C146.4,116.6 146.8,115.4 148,113 Z" />
            </group>

            <group android:name="drip_3">
                <path
                    android:fillColor="#CCE0F2FE"
                    android:pathData="M226,113 C227.1,115.2 227.5,116.4 227.5,117.5 C227.5,118.8 226.8,119.6 226,119.6 C225.2,119.6 224.5,118.8 224.5,117.5 C224.5,116.4 224.9,115.2 226,113 Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="rain_near">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="560"
                    android:valueFrom="-35"
                    android:valueTo="135"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <objectAnimator
                    android:propertyName="translateX"
                    android:duration="560"
                    android:valueFrom="8"
                    android:valueTo="-22"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="rain_mid">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="740"
                    android:valueFrom="-38"
                    android:valueTo="135"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator
                    android:propertyName="translateX"
                    android:duration="740"
                    android:valueFrom="6"
                    android:valueTo="-18"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="rain_far">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="980"
                    android:valueFrom="-40"
                    android:valueTo="135"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator
                    android:propertyName="translateX"
                    android:duration="980"
                    android:valueFrom="5"
                    android:valueTo="-14"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="drip_1">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="1150"
                    android:valueFrom="-2"
                    android:valueTo="34"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="1150"
                    android:valueFrom="1.1"
                    android:valueTo="0.0"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/accelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="drip_2">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="1420"
                    android:valueFrom="-2"
                    android:valueTo="36"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="1420"
                    android:valueFrom="1.1"
                    android:valueTo="0.0"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/accelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="drip_3">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateY"
                    android:duration="1680"
                    android:valueFrom="-2"
                    android:valueTo="34"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="1680"
                    android:valueFrom="1.1"
                    android:valueTo="0.0"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:anim/accelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
