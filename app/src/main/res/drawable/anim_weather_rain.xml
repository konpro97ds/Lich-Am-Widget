<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Tầng mưa bụi xa: vệt siêu mảnh, mờ nhẹ -->
            <group android:name="rain_far">
                <path
                    android:strokeColor="#38FFFFFF"
                    android:strokeWidth="0.45"
                    android:strokeLineCap="round"
                    android:pathData="M24,-30 L19,-12 M64,-42 L59,-22 M104,-26 L99,-8 M144,-38 L139,-18 M184,-28 L179,-10 M224,-40 L219,-20 M264,-24 L259,-6 M304,-36 L299,-16 M344,-26 L339,-8 M44,20 L39,38 M84,8 L79,28 M124,24 L119,42 M164,12 L159,32 M204,22 L199,40 M244,10 L239,30 M284,26 L279,44 M324,14 L319,34 M34,70 L29,88 M74,58 L69,78 M114,74 L109,92 M154,62 L149,82 M194,72 L189,90 M234,60 L229,80 M274,76 L269,94 M314,64 L309,84" />
            </group>

            <!-- Tầng mưa trung: vệt mưa dài rơi xiên -->
            <group android:name="rain_mid">
                <path
                    android:strokeColor="#66E0F2FE"
                    android:strokeWidth="0.65"
                    android:strokeLineCap="round"
                    android:pathData="M36,-36 L29,-12 M84,-20 L77,4 M132,-40 L125,-16 M180,-24 L173,0 M228,-38 L221,-14 M276,-22 L269,2 M324,-36 L317,-12 M22,18 L15,42 M70,32 L63,56 M118,14 L111,38 M166,28 L159,52 M214,16 L207,40 M262,30 L255,54 M310,14 L303,38 M48,68 L41,92 M96,82 L89,106 M144,64 L137,88 M192,78 L185,102 M240,66 L233,90 M288,80 L281,104 M336,64 L329,88" />
            </group>

            <!-- Tầng mưa gần: hạt mưa sắc nét rơi nhanh -->
            <group android:name="rain_near">
                <path
                    android:strokeColor="#99FFFFFF"
                    android:strokeWidth="0.85"
                    android:strokeLineCap="round"
                    android:pathData="M52,-44 L43,-14 M122,-26 L113,4 M192,-46 L183,-16 M262,-28 L253,2 M332,-42 L323,-12 M32,16 L23,46 M102,32 L93,62 M172,12 L163,42 M242,28 L233,58 M312,14 L303,44 M66,68 L57,98 M136,82 L127,112 M206,64 L197,94 M276,80 L267,110 M340,66 L331,96" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="rain_near">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="460" android:valueFrom="-30" android:valueTo="130" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="460" android:valueFrom="8" android:valueTo="-28" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="rain_mid">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="620" android:valueFrom="-35" android:valueTo="130" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="620" android:valueFrom="6" android:valueTo="-24" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="rain_far">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="840" android:valueFrom="-40" android:valueTo="130" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="840" android:valueFrom="5" android:valueTo="-18" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
