        <vector
            android:width="300dp"
            android:height="160dp"
            android:viewportWidth="300"
            android:viewportHeight="160">

            <!-- Tầng 1: Mưa bụi xa siêu mịn -->
            <group android:name="rain_far">
                <path
                    android:strokeColor="#44E0F2FE"
                    android:strokeWidth="0.55"
                    android:strokeLineCap="round"
                    android:pathData="M18,-26 L15,-18 M46,-14 L44,-8 M74,-32 L71,-22 M102,-18 L100,-12 M130,-28 L127,-19 M158,-12 L156,-6 M186,-30 L183,-20 M214,-16 L212,-10 M242,-26 L239,-17 M270,-14 L268,-8 M294,-28 L291,-19 M28,16 L25,24 M56,28 L54,34 M84,12 L81,22 M112,24 L110,30 M140,14 L137,23 M168,26 L166,32 M196,12 L193,22 M224,24 L222,30 M252,16 L249,24 M280,28 L278,34 M22,56 L19,64 M50,68 L48,74 M78,52 L75,62 M106,64 L104,70 M134,54 L131,63 M162,66 L160,72 M190,52 L187,62 M218,64 L216,70 M246,56 L243,64 M274,68 L272,74" />
