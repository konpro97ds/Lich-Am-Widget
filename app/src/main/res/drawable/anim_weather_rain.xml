<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Tầng mưa bụi xa (mảnh, mờ nhẹ) -->
            <group android:name="rain_far">
                <path
                    android:strokeColor="#40E0F2FE"
                    android:strokeWidth="0.6"
                    android:strokeLineCap="round"
                    android:pathData="M22,-20 L18,-10 M58,-32 L54,-20 M94,-16 L90,-6 M130,-28 L126,-16 M166,-18 L162,-8 M202,-30 L198,-18 M238,-14 L234,-4 M274,-26 L270,-14 M310,-18 L306,-8 M342,-28 L338,-16 M40,26 L36,36 M76,14 L72,26 M112,30 L108,40 M148,18 L144,30 M184,28 L180,38 M220,16 L216,28 M256,32 L252,42 M292,20 L288,32 M328,28 L324,38 M28,68 L24,78 M64,56 L60,68 M100,72 L96,82 M136,60 L132,72 M172,70 L168,80 M208,58 L204,70 M244,74 L240,84 M280,62 L276,74 M316,70 L312,80" />
            </group>

            <!-- Tầng mưa vừa -->
            <group android:name="rain_mid">
                <path
                    android:strokeColor="#66E0F2FE"
                    android:strokeWidth="0.85"
                    android:strokeLineCap="round"
                    android:pathData="M34,-28 L28,-13 M78,-14 L72,1 M122,-32 L116,-16 M166,-18 L160,-3 M210,-30 L204,-14 M254,-16 L248,-1 M298,-28 L292,-12 M338,-18 L332,-3 M20,22 L14,37 M64,34 L58,49 M108,18 L102,34 M152,30 L146,45 M196,20 L190,36 M240,32 L234,47 M284,18 L278,34 M328,28 L322,43 M46,64 L40,79 M90,76 L84,91 M134,60 L128,76 M178,72 L172,87 M222,62 L216,78 M266,74 L260,89 M310,60 L304,76" />
            </group>

            <!-- Tầng mưa gần (dài, rõ nét) -->
            <group android:name="rain_near">
                <path
                    android:strokeColor="#8CFFFFFF"
                    android:strokeWidth="1.05"
                    android:strokeLineCap="round"
                    android:pathData="M48,-36 L40,-16 M114,-20 L106,0 M180,-38 L172,-18 M246,-22 L238,-2 M312,-34 L304,-14 M30,20 L22,40 M96,34 L88,54 M162,16 L154,36 M228,30 L220,50 M294,18 L286,38 M62,66 L54,86 M128,78 L120,98 M194,62 L186,82 M260,76 L252,96 M326,64 L318,84" />
            </group>

            <!-- Vệt nước mưa trượt chậm trên mặt kính -->
            <group android:name="glass_water_streaks">
                <path
                    android:strokeColor="#38FFFFFF"
                    android:strokeWidth="1.4"
                    android:strokeLineCap="round"
                    android:pathData="M86,18 L86,34 M192,14 L192,32 M288,22 L288,40 M144,48 L144,64 M248,44 L248,62" />
            </group>

            <!-- Màng nước loang mỏng ngay đúng mép trên dải lịch tuần (Y = 97) -->
            <path
                android:name="week_bar_ripple"
                android:strokeColor="#BAE6FD"
                android:strokeWidth="1.1"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:pathData="M46,97 L62,97 M124,97 L142,97 M212,97 L228,97 M294,97 L310,97" />
        </vector>
    </aapt:attr>

    <target android:name="rain_near">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="520" android:valueFrom="-35" android:valueTo="130" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="520" android:valueFrom="8" android:valueTo="-22" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="rain_mid">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="700" android:valueFrom="-38" android:valueTo="130" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="700" android:valueFrom="6" android:valueTo="-18" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="rain_far">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="940" android:valueFrom="-40" android:valueTo="130" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="940" android:valueFrom="5" android:valueTo="-14" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="glass_water_streaks">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateY" android:duration="2600" android:valueFrom="0" android:valueTo="52" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/accelerate_interpolator" />
        </aapt:attr>
    </target>

    <target android:name="week_bar_ripple">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:duration="520" android:valueFrom="0.0" android:valueTo="0.55" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
