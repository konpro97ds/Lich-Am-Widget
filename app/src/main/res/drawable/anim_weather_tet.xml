            <group android:name="mai_petals_layer" android:pivotX="210" android:pivotY="60">
                <path
                    android:fillColor="#F5FDE047"
                    android:pathData="M152,14 C155,11 159,14 156,18 C153,21 149,18 152,14 Z M208,8 C211,5 215,8 212,12 C209,15 205,12 208,8 Z M265,18 C268,15 272,18 269,22 C266,25 262,22 265,18 Z M312,12 C315,9 319,12 316,16 C313,19 309,16 312,12 Z M182,36 C185,33 189,36 186,40 C183,43 179,40 182,36 Z M242,42 C245,39 249,42 246,46 C243,49 239,46 242,42 Z M292,38 C295,35 299,38 296,42 C293,45 289,42 292,38 Z" />
            </group>

            <!-- Cánh hoa đào hồng rơi lớp 2 -->
            <group android:name="dao_petals_layer" android:pivotX="230" android:pivotY="70">
                <path
                    android:fillColor="#EBFDA4AF"
                    android:pathData="M168,24 C171,21 175,24 172,28 C169,31 165,28 168,24 Z M224,18 C227,15 231,18 228,22 C225,25 221,22 224,18 Z M280,26 C283,23 287,26 284,30 C281,33 277,30 280,26 Z M330,22 C333,19 337,22 334,26 C331,29 327,26 330,22 Z M198,50 C201,47 205,50 202,54 C199,57 195,54 198,50 Z M258,54 C261,51 265,54 262,58 C259,61 255,58 258,54 Z" />
            </group>

            <!-- Tia pháo hoa bung nở nhẹ -->
            <group android:name="firework_burst" android:pivotX="236" android:pivotY="54">
                <path
                    android:strokeColor="#CCFEF08A"
                    android:strokeWidth="1.3"
                    android:strokeLineCap="round"
                    android:pathData="M236,36 L236,44 M236,64 L236,72 M218,54 L226,54 M246,54 L254,54 M223,41 L229,47 M243,61 L249,67 M249,41 L243,47 M229,61 L223,67" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="mai_petals_layer">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="3100" android:valueFrom="-12" android:valueTo="115" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="1550" android:valueFrom="-8" android:valueTo="8" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
                <objectAnimator android:propertyName="rotation" android:duration="3100" android:valueFrom="-10" android:valueTo="14" android:repeatCount="infinite" android:repeatMode="reverse" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="dao_petals_layer">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="3800" android:valueFrom="-15" android:valueTo="120" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="1900" android:valueFrom="7" android:valueTo="-7" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="firework_burst">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:duration="1600" android:valueFrom="0.15" android:valueTo="1.25" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:duration="1600" android:valueFrom="0.15" android:valueTo="1.25" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
