            <objectAnimator android:propertyName="fillAlpha" android:duration="1500" android:valueFrom="0.15" android:valueTo="0.95" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <target android:name="mai_petals_layer">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="3300" android:valueFrom="-12" android:valueTo="120" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="1650" android:valueFrom="-7" android:valueTo="7" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="dao_petals_layer">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="4100" android:valueFrom="-15" android:valueTo="125" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="2050" android:valueFrom="6" android:valueTo="-6" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
