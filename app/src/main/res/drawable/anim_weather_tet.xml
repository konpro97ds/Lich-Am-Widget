            <path
                android:name="fw_ambient_glow"
                android:fillColor="#FDE047"
                android:fillAlpha="0.0"
                android:pathData="M0,0 L360,0 L360,168 L0,168 Z" />

            <!-- Cánh hoa mai vàng rơi -->
            <group android:name="mai_petals_layer" android:pivotX="210" android:pivotY="60">
                <path
                    android:fillColor="#F5FDE047"
                    android:pathData="M148,14 C151,11 155,14 152,18 C149,21 145,18 148,14 Z M206,8 C209,5 213,8 210,12 C207,15 203,12 206,8 Z M264,18 C267,15 271,18 268,22 C265,25 261,22 264,18 Z M314,12 C317,9 321,12 318,16 C315,19 311,16 314,12 Z M180,38 C183,35 187,38 184,42 C181,45 177,42 180,38 Z M242,44 C245,41 249,44 246,48 C243,51 239,48 242,44 Z M294,40 C297,37 301,40 298,44 C295,47 291,44 294,40 Z" />
