    <target android:name="sparkle_glitter_a">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="1200" android:valueFrom="0.95" android:valueTo="0.15" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <target android:name="sparkle_glitter_b">
