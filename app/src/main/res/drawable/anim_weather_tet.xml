    <target android:name="fw_ambient_glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="fillAlpha" android:duration="550" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="140" android:valueFrom="0.0" android:valueTo="0.14" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="380" android:valueFrom="0.14" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="750" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="140" android:valueFrom="0.0" android:valueTo="0.12" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="440" android:valueFrom="0.12" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="mai_petals_layer">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="3100" android:valueFrom="-12" android:valueTo="115" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="1550" android:valueFrom="-8" android:valueTo="8" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="dao_petals_layer">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateY" android:duration="3800" android:valueFrom="-15" android:valueTo="120" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator android:propertyName="translateX" android:duration="1900" android:valueFrom="7" android:valueTo="-7" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="fw_cluster_1">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:duration="1500" android:valueFrom="0.1" android:valueTo="1.25" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:duration="1500" android:valueFrom="0.1" android:valueTo="1.25" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="fw_cluster_2">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:duration="2150" android:valueFrom="0.1" android:valueTo="1.2" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:duration="2150" android:valueFrom="0.1" android:valueTo="1.2" android:repeatCount="infinite" android:repeatMode="restart" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
