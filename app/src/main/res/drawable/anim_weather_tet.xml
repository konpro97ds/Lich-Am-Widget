            <!-- Cánh hoa đào hồng rơi -->
            <group android:name="dao_petals_layer" android:pivotX="230" android:pivotY="70">
                <path
                    android:fillColor="#EBFDA4AF"
                    android:pathData="M166,24 C169,21 173,24 170,28 C167,31 163,28 166,24 Z M222,18 C225,15 229,18 226,22 C223,25 219,22 222,18 Z M278,26 C281,23 285,26 282,30 C279,33 275,30 278,26 Z M328,22 C331,19 335,22 332,26 C329,29 325,26 328,22 Z M196,52 C199,49 203,52 200,56 C197,59 193,56 196,52 Z M256,56 C259,53 263,56 260,60 C257,63 253,60 256,56 Z" />
            </group>

            <!-- Chùm pháo hoa 1 (Tâm vàng cam rực rỡ) -->
            <group android:name="fw_cluster_1" android:pivotX="186" android:pivotY="44">
                <path
                    android:strokeColor="#FEF08A"
                    android:strokeWidth="1.5"
                    android:strokeLineCap="round"
                    android:pathData="M186,24 L186,33 M186,55 L186,64 M166,44 L175,44 M197,44 L206,44 M172,30 L178,36 M194,52 L200,58 M200,30 L194,36 M178,52 L172,58" />
                <path
                    android:fillColor="#FB923C"
                    android:pathData="M186,21 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 M186,67 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 M163,44 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 M209,44 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0" />
            </group>

            <!-- Chùm pháo hoa 2 (Lệch phải, ánh hồng vàng) -->
            <group android:name="fw_cluster_2" android:pivotX="268" android:pivotY="38">
                <path
                    android:strokeColor="#FDA4AF"
                    android:strokeWidth="1.4"
                    android:strokeLineCap="round"
                    android:pathData="M268,20 L268,28 M268,48 L268,56 M250,38 L258,38 M278,38 L286,38 M255,25 L261,31 M275,45 L281,51 M281,25 L275,31 M261,45 L255,51" />
                <path
