                <objectAnimator android:propertyName="fillAlpha" android:duration="120" android:valueFrom="0.0" android:valueTo="0.22" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="340" android:valueFrom="0.22" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="620" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="120" android:valueFrom="0.0" android:valueTo="0.20" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="380" android:valueFrom="0.20" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="mai_petals_layer">
        <aapt:attr name="android:animation">
