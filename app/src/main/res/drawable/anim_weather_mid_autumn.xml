<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Sao & đom đóm ánh vàng lấp lánh -->
            <path
                android:name="autumn_stars"
                android:fillColor="#FEF08A"
                android:fillAlpha="0.95"
                android:pathData="M148,22 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0 M198,16 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 M312,24 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 M334,60 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0" />

            <!-- Dãy đèn ông sao 5 cánh & đèn lồng đung đưa dọc mép trên dải lịch -->
            <group android:name="lantern_swing">
                <!-- Đèn ông sao 1 (X=86) & Đèn ông sao 2 (X=226) -->
                <path
                    android:fillColor="#FACC15"
                    android:pathData="M86,87 L87.8,92.5 L93.5,92.5 L88.9,95.8 L90.6,101.2 L86,97.9 L81.4,101.2 L83.1,95.8 L78.5,92.5 L84.2,92.5 Z M226,87 L227.8,92.5 L233.5,92.5 L228.9,95.8 L230.6,101.2 L226,97.9 L221.4,101.2 L223.1,95.8 L218.5,92.5 L224.2,92.5 Z" />
                <path
                    android:fillColor="#EF4444"
                    android:pathData="M86,94.5 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0 M226,94.5 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0" />

                <!-- Đèn lồng tròn đỏ 1 (X=156) & 2 (X=296) -->
                <path
                    android:fillColor="#DC2626"
                    android:pathData="M156,94 m-3.8,0 a3.8,4.4 0 1,0 7.6,0 a3.8,4.4 0 1,0 -7.6,0 M296,94 m-3.8,0 a3.8,4.4 0 1,0 7.6,0 a3.8,4.4 0 1,0 -7.6,0" />
                <path
                    android:fillColor="#FEF08A"
                    android:pathData="M156,94 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0 M296,94 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="autumn_stars">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="1600" android:valueFrom="0.95" android:valueTo="0.20" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <target android:name="lantern_swing">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:duration="1800" android:valueFrom="-3" android:valueTo="3" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
