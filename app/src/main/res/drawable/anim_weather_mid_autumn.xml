<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Sao & đom đóm ánh vàng lấp lánh tại chỗ -->
            <path
                android:name="autumn_stars_a"
                android:fillColor="#FEF08A"
                android:fillAlpha="0.95"
                android:pathData="M148,22 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0 M198,16 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 M226,68 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 M312,24 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 M334,60 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0" />

            <path
                android:name="autumn_stars_b"
                android:fillColor="#FDE047"
                android:fillAlpha="0.2"
                android:pathData="M172,42 m-1.3,0 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 M210,32 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0 M302,46 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 M325,38 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0" />

            <!-- Dây treo & đèn lồng Trung Thu đung đưa dọc mép dải lịch (Y = 93) -->
            <group android:name="lantern_swing" android:pivotX="180" android:pivotY="90">
                <path
                    android:strokeColor="#FACC15"
                    android:strokeWidth="0.9"
                    android:pathData="M92,89 L92,93 M162,89 L162,93 M232,89 L232,93 M302,89 L302,93" />
                <path
                    android:fillColor="#DC2626"
                    android:pathData="M92,95 m-3.6,0 a3.6,4.2 0 1,0 7.2,0 a3.6,4.2 0 1,0 -7.2,0 M162,95 m-3.6,0 a3.6,4.2 0 1,0 7.2,0 a3.6,4.2 0 1,0 -7.2,0 M232,95 m-3.6,0 a3.6,4.2 0 1,0 7.2,0 a3.6,4.2 0 1,0 -7.2,0 M302,95 m-3.6,0 a3.6,4.2 0 1,0 7.2,0 a3.6,4.2 0 1,0 -7.2,0" />
                <path
                    android:fillColor="#FEF08A"
                    android:pathData="M92,95 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0 M162,95 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0 M232,95 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0 M302,95 m-1.5,0 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="autumn_stars_a">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="1600" android:valueFrom="0.95" android:valueTo="0.20" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <target android:name="autumn_stars_b">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="2100" android:valueFrom="0.20" android:valueTo="0.95" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>

    <target android:name="lantern_swing">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:duration="1800" android:valueFrom="-2.5" android:valueTo="2.5" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
