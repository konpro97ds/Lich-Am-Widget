            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Màn chớp sáng bầu trời (đồng bộ 100% keyframe với tia sét) -->
            <path
                android:name="sky_flash"
                android:fillColor="#E0F2FE"
                android:fillAlpha="0.0"
                android:pathData="M0,0 L360,0 L360,168 L0,168 Z" />

            <!-- Tia sét 1: Giữa bụng mây giông góc phải (X = 312, Y = 40 -> 84) -->
            <path
                android:name="bolt_1_glow"
                android:strokeColor="#38BDF8"
                android:strokeWidth="3.2"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M312,40 L306,49 L311,51 L303,61 L308,63 L299,74 L303,76 L295,85 M308,50 L316,58 L314,64 M305,62 L298,69 M301,72 L308,79" />
            <path
                android:name="bolt_1_core"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.15"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M312,40 L306,49 L311,51 L303,61 L308,63 L299,74 L303,76 L295,85 M308,50 L316,58 L314,64 M305,62 L298,69 M301,72 L308,79" />

            <!-- Tia sét 2: Rìa trái cụm mây giông (X = 282, Y = 42 -> 82) -->
            <path
                android:name="bolt_2_glow"
                android:strokeColor="#7DD3FC"
                android:strokeWidth="2.8"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M282,42 L277,51 L282,53 L274,63 L279,65 L271,76 L275,78 L268,85 M279,52 L286,59 M276,64 L269,71" />
            <path
                android:name="bolt_2_core"
                android:strokeColor="#FEF9C3"
                android:strokeWidth="1.05"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M282,42 L277,51 L282,53 L274,63 L279,65 L271,76 L275,78 L268,85 M279,52 L286,59 M276,64 L269,71" />

            <!-- Tia sét 3: Mép phải cụm mây giông (X = 336, Y = 40 -> 82) -->
            <path
                android:name="bolt_3_glow"
                android:strokeColor="#38BDF8"
                android:strokeWidth="2.8"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M336,40 L331,49 L336,51 L329,61 L333,63 L326,74 L329,76 L323,83 M333,50 L340,57 L338,63 M330,62 L324,69" />
            <path
                android:name="bolt_3_core"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.05"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M336,40 L331,49 L336,51 L329,61 L333,63 L326,74 L329,76 L323,83 M333,50 L340,57 L338,63 M330,62 L324,69" />
        </vector>
    </aapt:attr>

    <!-- Ánh chớp bầu trời đồng bộ tuyệt đối 100% cùng thời điểm với từng tia sét -->
    <target android:name="sky_flash">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="16000" android:repeatCount="infinite" android:repeatMode="restart">
                <propertyValuesHolder android:propertyName="fillAlpha">
                    <!-- Đợt 1 (Tia 1 chớp kép: 0.02 -> 0.05) -->
                    <keyframe android:fraction="0.000" android:value="0.0" />
                    <keyframe android:fraction="0.015" android:value="0.0" />
                    <keyframe android:fraction="0.020" android:value="0.42" />
                    <keyframe android:fraction="0.026" android:value="0.06" />
                    <keyframe android:fraction="0.032" android:value="0.48" />
                    <keyframe android:fraction="0.052" android:value="0.0" />
                    <!-- Đợt 2 (Tia 2 chớp đơn: 0.22 -> 0.245) -->
                    <keyframe android:fraction="0.215" android:value="0.0" />
                    <keyframe android:fraction="0.220" android:value="0.36" />
                    <keyframe android:fraction="0.245" android:value="0.0" />
                    <!-- Đợt 3 (Tia 1 + Tia 3 giật liên hoàn 3 nhịp: 0.48 -> 0.53) -->
                    <keyframe android:fraction="0.475" android:value="0.0" />
                    <keyframe android:fraction="0.480" android:value="0.45" />
                    <keyframe android:fraction="0.486" android:value="0.08" />
                    <keyframe android:fraction="0.492" android:value="0.52" />
                    <keyframe android:fraction="0.498" android:value="0.10" />
                    <keyframe android:fraction="0.504" android:value="0.40" />
                    <keyframe android:fraction="0.528" android:value="0.0" />
                    <!-- Đợt 4 (Tia 3 chớp kép: 0.76 -> 0.79) -->
                    <keyframe android:fraction="0.755" android:value="0.0" />
                    <keyframe android:fraction="0.760" android:value="0.42" />
                    <keyframe android:fraction="0.766" android:value="0.06" />
                    <keyframe android:fraction="0.772" android:value="0.44" />
                    <keyframe android:fraction="0.792" android:value="0.0" />
                    <keyframe android:fraction="1.000" android:value="0.0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Tia sét 1 (Khớp 100% mốc 0.020 và 0.480 với sky_flash) -->
    <target android:name="bolt_1_glow">
