<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Màn chớp sáng bầu trời (Flash) khi sét đánh -->
            <path
                android:name="sky_flash"
                android:fillColor="#FFFFFFFF"
                android:fillAlpha="0.0"
                android:pathData="M0,0 L360,0 L360,168 L0,168 Z" />

            <!-- Quầng sáng quanh tia sét -->
            <path
                android:name="bolt_glow"
                android:strokeColor="#99BAE6FD"
                android:strokeWidth="6.0"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M214,44 L203,64 L214,67 L199,90 L209,93 L194,116" />

            <!-- Lõi tia sét chính sắc nét -->
            <path
                android:name="bolt_core"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="2.2"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M214,44 L203,64 L214,67 L199,90 L209,93 L194,116 M211,67 L223,80 L219,92 M203,86 L191,99" />

            <!-- Tia sét phụ phía xa -->
            <path
                android:name="bolt_secondary"
                android:strokeColor="#FEF08A"
                android:strokeWidth="1.6"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M268,48 L260,65 L268,68 L257,88 L264,91 L253,108" />
        </vector>
    </aapt:attr>

    <!-- Nhịp chớp sáng bầu trời (giật 2 phát liên tiếp rồi nghỉ) -->
    <target android:name="sky_flash">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="fillAlpha" android:duration="1100" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="70" android:valueFrom="0.0" android:valueTo="0.32" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="90" android:valueFrom="0.32" android:valueTo="0.04" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="70" android:valueFrom="0.04" android:valueTo="0.26" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="260" android:valueFrom="0.26" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="900" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <!-- Quầng sáng tia sét chính -->
    <target android:name="bolt_glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1100" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="70" android:valueFrom="0.0" android:valueTo="0.75" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="90" android:valueFrom="0.75" android:valueTo="0.15" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="70" android:valueFrom="0.15" android:valueTo="0.70" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="260" android:valueFrom="0.70" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="900" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <!-- Lõi tia sét chính -->
    <target android:name="bolt_core">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1100" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="70" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="90" android:valueFrom="1.0" android:valueTo="0.2" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="70" android:valueFrom="0.2" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="260" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="900" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <!-- Tia sét phụ chớp lệch nhịp -->
    <target android:name="bolt_secondary">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1850" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="80" android:valueFrom="0.0" android:valueTo="0.90" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="220" android:valueFrom="0.90" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="340" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
