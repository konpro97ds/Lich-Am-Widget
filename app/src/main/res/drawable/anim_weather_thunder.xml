                    <keyframe android:fraction="0.015" android:value="0.0" />
                    <keyframe android:fraction="0.020" android:value="1.0" />
                    <keyframe android:fraction="0.026" android:value="0.30" />
                    <keyframe android:fraction="0.032" android:value="1.0" />
                    <keyframe android:fraction="0.052" android:value="0.0" />
                    <keyframe android:fraction="0.475" android:value="0.0" />
                    <keyframe android:fraction="0.480" android:value="1.0" />
                    <keyframe android:fraction="0.486" android:value="0.30" />
                    <keyframe android:fraction="0.492" android:value="1.0" />
