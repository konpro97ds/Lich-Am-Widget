<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Màn chớp sáng mây giông -->
            <path
                android:name="sky_flash"
                android:fillColor="#E0F2FE"
                android:fillAlpha="0.0"
                android:pathData="M0,0 L360,0 L360,168 L0,168 Z" />

            <!-- Tia sét 1 (Đợt đầu: lệch trái mây) -->
            <path
                android:name="bolt_1"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="2.0"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M186,42 L177,57 L186,60 L172,78 L180,81 L167,100 M181,59 L192,70" />

            <!-- Tia sét 2 (Đợt giữa: rẽ nhánh mạnh trung tâm) -->
            <path
                android:name="bolt_2"
                android:strokeColor="#FEF9C3"
                android:strokeWidth="2.2"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M236,38 L227,54 L237,57 L221,76 L230,79 L215,102 M231,56 L244,68 L240,80 M224,74 L212,86" />

            <!-- Tia sét 3 (Đợt cuối: chớp xa bên phải) -->
            <path
                android:name="bolt_3"
                android:strokeColor="#BAE6FD"
                android:strokeWidth="1.7"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M292,44 L285,59 L293,62 L281,81 L288,84 L277,100" />
        </vector>
    </aapt:attr>

    <!-- Chớp sáng ngẫu nhiên theo cả 3 đợt sấm sét -->
    <target android:name="sky_flash">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <!-- Đợt 1 -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="120" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="0.28" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="160" android:valueFrom="0.28" android:valueTo="0.0" />
                <!-- Nghỉ ngẫu nhiên 1.5s -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="1500" android:valueFrom="0.0" android:valueTo="0.0" />
                <!-- Đợt 2 (giật kép mạnh) -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.34" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="65" android:valueFrom="0.34" android:valueTo="0.06" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.06" android:valueTo="0.30" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="200" android:valueFrom="0.30" android:valueTo="0.0" />
                <!-- Nghỉ 2.1s -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="2100" android:valueFrom="0.0" android:valueTo="0.0" />
                <!-- Đợt 3 -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="65" android:valueFrom="0.0" android:valueTo="0.24" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="180" android:valueFrom="0.24" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="835" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="120" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="160" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="5060" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_2">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1840" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="65" android:valueFrom="1.0" android:valueTo="0.25" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.25" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="200" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3180" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_3">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="4320" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="65" android:valueFrom="0.0" android:valueTo="0.95" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="180" android:valueFrom="0.95" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="835" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
