<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Màn chớp sáng bầu trời mạnh -->
            <path
                android:name="sky_flash"
                android:fillColor="#E0F2FE"
                android:fillAlpha="0.0"
                android:pathData="M0,0 L360,0 L360,168 L0,168 Z" />

            <!-- Tia sét A (Trái mây - nhánh lớn) -->
            <path
                android:name="bolt_a"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="2.4"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M174,36 L163,54 L174,58 L158,79 L168,83 L152,106 M168,57 L181,70 L177,83 M162,76 L149,89" />

            <!-- Tia sét B (Trung tâm - giật siêu mạnh) -->
            <path
                android:name="bolt_b"
                android:strokeColor="#FEF9C3"
                android:strokeWidth="2.7"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M234,32 L222,52 L235,56 L216,80 L228,84 L210,112 M227,55 L243,69 L238,84 M220,76 L205,92" />

            <!-- Tia sét C (Bên phải - chớp nhanh) -->
            <path
                android:name="bolt_c"
                android:strokeColor="#7DD3FC"
                android:strokeWidth="2.1"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M294,38 L285,55 L295,59 L280,80 L289,84 L276,104 M289,58 L302,71" />

            <!-- Tia sét D (Giữa trái - chớp rìa mây) -->
            <path
                android:name="bolt_d"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.9"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M204,40 L196,56 L204,59 L192,78 L199,81 L188,98" />
        </vector>
    </aapt:attr>

    <!-- Chuỗi 7 nhịp chớp bầu trời bất đối xứng trong 9200ms -->
    <target android:name="sky_flash">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <!-- 1. Chớp mở màn ngay khi bật -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="90" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.48" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.48" android:valueTo="0.08" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.08" android:valueTo="0.52" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="180" android:valueFrom="0.52" android:valueTo="0.0" />
                <!-- Nghỉ 0.95s -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="950" android:valueFrom="0.0" android:valueTo="0.0" />
                <!-- 2. Chớp nhanh đơn -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.42" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="150" android:valueFrom="0.42" android:valueTo="0.0" />
                <!-- Nghỉ 1.85s -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="1850" android:valueFrom="0.0" android:valueTo="0.0" />
                <!-- 3. Giật liên hoàn 3 phát dồn dập -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="50" android:valueFrom="0.0" android:valueTo="0.46" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.46" android:valueTo="0.05" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="50" android:valueFrom="0.05" android:valueTo="0.54" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.54" android:valueTo="0.10" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.10" android:valueTo="0.45" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="210" android:valueFrom="0.45" android:valueTo="0.0" />
                <!-- Nghỉ 1.3s -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="1300" android:valueFrom="0.0" android:valueTo="0.0" />
                <!-- 4. Chớp lệch phải -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="0.40" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="160" android:valueFrom="0.40" android:valueTo="0.0" />
                <!-- Nghỉ 2.4s -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="2400" android:valueFrom="0.0" android:valueTo="0.0" />
                <!-- 5. Chớp kép cuối chu kỳ -->
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.48" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="65" android:valueFrom="0.48" android:valueTo="0.06" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.06" android:valueTo="0.44" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="190" android:valueFrom="0.44" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="990" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_a">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1390" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="150" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="6250" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="65" android:valueFrom="1.0" android:valueTo="0.2" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.2" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="190" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="990" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_b">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="90" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="1.0" android:valueTo="0.25" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.25" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="180" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3005" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="50" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="1.0" android:valueTo="0.2" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="50" android:valueFrom="0.2" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="1.0" android:valueTo="0.3" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.3" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="210" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="5275" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_c">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="5225" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="160" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3755" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_d">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3550" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="190" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="5405" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
