<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Chớp sáng toàn vùng mây giông -->
            <path
                android:name="cloud_flash"
                android:fillColor="#E0F2FE"
                android:fillAlpha="0.0"
                android:pathData="M0,0 L360,0 L360,168 L0,168 Z" />

            <!-- Quầng hào quang xanh điện quanh tia sét 1 -->
            <path
                android:name="bolt1_glow"
                android:strokeColor="#38BDF8"
                android:strokeWidth="5.5"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M210,38 L202,53 L211,56 L197,74 L205,77 L191,98 M204,55 L216,66 L213,77 M199,73 L188,84" />

            <!-- Lõi trắng sắc nét tia sét 1 -->
            <path
                android:name="bolt1_core"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.9"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M210,38 L202,53 L211,56 L197,74 L205,77 L191,98 M204,55 L216,66 L213,77 M199,73 L188,84" />

            <!-- Quầng hào quang tia sét 2 (bên phải) -->
            <path
                android:name="bolt2_glow"
                android:strokeColor="#7DD3FC"
                android:strokeWidth="4.5"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M276,40 L269,54 L276,57 L264,75 L271,78 L260,96 M271,56 L282,67" />

            <!-- Lõi trắng tia sét 2 -->
            <path
                android:name="bolt2_core"
                android:strokeColor="#FEF9C3"
                android:strokeWidth="1.6"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M276,40 L269,54 L276,57 L264,75 L271,78 L260,96 M271,56 L282,67" />
        </vector>
    </aapt:attr>

    <!-- Chớp sáng bầu trời (xuất hiện ngay 120ms đầu khi vừa bật hiệu ứng, lặp lại dày dặn mỗi 1.55s) -->
    <target android:name="cloud_flash">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="fillAlpha" android:duration="100" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.28" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="65" android:valueFrom="0.28" android:valueTo="0.05" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.05" android:valueTo="0.34" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="180" android:valueFrom="0.34" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="420" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.22" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="165" android:valueFrom="0.22" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="450" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <!-- Tia sét 1 (giật kép ngay đầu chu kỳ) -->
    <target android:name="bolt1_glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="100" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.80" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="65" android:valueFrom="0.80" android:valueTo="0.15" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.15" android:valueTo="0.90" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="180" android:valueFrom="0.90" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1090" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt1_core">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="100" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="65" android:valueFrom="1.0" android:valueTo="0.25" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.25" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="180" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1090" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <!-- Tia sét 2 (đánh nối tiếp ở giữa chu kỳ) -->
    <target android:name="bolt2_glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="880" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.85" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="165" android:valueFrom="0.85" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="450" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt2_core">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="880" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="165" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="450" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
