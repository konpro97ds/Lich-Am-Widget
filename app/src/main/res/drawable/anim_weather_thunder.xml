<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="360dp"
            android:height="168dp"
            android:viewportWidth="360"
            android:viewportHeight="168">

            <!-- Màn chớp sáng toàn bầu trời -->
            <path
                android:name="sky_flash"
                android:fillColor="#E0F2FE"
                android:fillAlpha="0.0"
                android:pathData="M0,0 L360,0 L360,168 L0,168 Z" />

            <!-- Quầng sáng điện lóe lên ngay trong lòng đám mây giông bên phải -->
            <path
                android:name="cloud_core_glow"
                android:fillColor="#7DD3FC"
                android:fillAlpha="0.0"
                android:pathData="M282,42 m-42,0 a42,22 0 1,0 84,0 a42,22 0 1,0 -84,0" />

            <!-- Hào quang xanh quanh tia sét chính (giữa mây bên phải X=278) -->
            <path
                android:name="bolt_main_glow"
                android:strokeColor="#38BDF8"
                android:strokeWidth="5.5"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M280,40 L270,54 L280,58 L265,74 L274,77 L260,92 M274,56 L287,67 L283,77 M269,71 L258,81" />

            <!-- Lõi trắng sắc nét tia sét chính -->
            <path
                android:name="bolt_main_core"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="2.0"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M280,40 L270,54 L280,58 L265,74 L274,77 L260,92 M274,56 L287,67 L283,77 M269,71 L258,81" />

            <!-- Tia sét phụ 1 (bên trái đám mây X=242) -->
            <path
                android:name="bolt_left"
                android:strokeColor="#FEF9C3"
                android:strokeWidth="1.9"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M244,44 L236,56 L244,59 L232,74 L239,77 L228,90 M239,58 L249,68" />

            <!-- Tia sét phụ 2 (mép phải đám mây X=316) -->
            <path
                android:name="bolt_right"
                android:strokeColor="#BAE6FD"
                android:strokeWidth="1.8"
                android:strokeAlpha="0.0"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M316,42 L309,55 L316,58 L305,73 L312,76 L302,89 M311,57 L321,67" />
        </vector>
    </aapt:attr>

    <!-- Chớp bầu trời & lóe sáng lòng mây -->
    <target android:name="sky_flash">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="fillAlpha" android:duration="80" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.45" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.45" android:valueTo="0.08" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.08" android:valueTo="0.50" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="170" android:valueFrom="0.50" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="1100" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="0.40" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="160" android:valueFrom="0.40" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="1800" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.48" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.48" android:valueTo="0.08" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.08" android:valueTo="0.52" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="190" android:valueFrom="0.52" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="1900" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="0.42" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="170" android:valueFrom="0.42" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="900" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="cloud_core_glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="fillAlpha" android:duration="80" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.65" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="60" android:valueFrom="0.65" android:valueTo="0.15" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.15" android:valueTo="0.72" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="170" android:valueFrom="0.72" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="3120" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.68" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.68" android:valueTo="0.15" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="55" android:valueFrom="0.15" android:valueTo="0.75" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="190" android:valueFrom="0.75" android:valueTo="0.0" />
                <objectAnimator android:propertyName="fillAlpha" android:duration="3030" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_main_glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="80" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.85" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.85" android:valueTo="0.2" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.2" android:valueTo="0.95" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="170" android:valueFrom="0.95" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3120" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="0.85" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.85" android:valueTo="0.2" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.2" android:valueTo="0.95" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="190" android:valueFrom="0.95" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3030" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_main_core">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="80" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="1.0" android:valueTo="0.3" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.3" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="170" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3120" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="1.0" android:valueTo="0.3" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="55" android:valueFrom="0.3" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="190" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="3030" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_left">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="1520" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="160" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="5185" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bolt_right">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="strokeAlpha" android:duration="5795" android:valueFrom="0.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="60" android:valueFrom="0.0" android:valueTo="1.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="170" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="strokeAlpha" android:duration="900" android:valueFrom="0.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
